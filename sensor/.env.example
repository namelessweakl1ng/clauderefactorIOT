SENSOR_ID=pi-01
# ANALYSIS_HOST is the laptop's stable Tailscale address (MagicDNS name preferred).
# Filebeat ships logs to it over the Tailscale overlay, so log shipping survives
# the Pi moving between the home router and a phone hotspot.
ANALYSIS_HOST=trapsig-laptop.your-tailnet.ts.net
LOGSTASH_PORT=5044
HONEYPOT_HOSTNAME=trapsig-pi
# SENSOR_IP is the Pi's address on the physical lab LAN (where attacks originate),
# not its Tailscale address.
SENSOR_IP=192.168.50.10
# Backend adaptation endpoint the honeypot posture poller reads (Tailscale address
# of the laptop). Leave blank to disable posture-driven deception (fail-open).
BACKEND_URL=http://trapsig-laptop.your-tailnet.ts.net:8000
# Max concurrent connections per source IP each honeypot will serve (0 = no cap).
# Bounds the self-DoS risk of the posture tarpit delay under a connection flood.
SENSOR_MAX_CONNECTIONS_PER_IP=24
# Sensor-role API key (backend API_KEYS entry "sensor:<key>"). Lets heartbeats,
# posture polls and persona fetches authenticate; it cannot read telemetry.
SENSOR_API_KEY=
# true: persona containers fetch the backend's active persona version at start
# (fallback: the baked-in TOML). false: always use the baked-in file.
PERSONA_FROM_BACKEND=false
# Passive monitoring (only with --profile netmon): lab-facing interface and BPF.
ZEEK_INTERFACE=eth0
ZEEK_BPF=not port 22 and not port 5044 and not port 41641 and not port 8000
