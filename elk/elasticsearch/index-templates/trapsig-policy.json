{
  "index_patterns": [
    "trapsig-policy"
  ],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "policy_version": {
          "type": "keyword"
        },
        "feature_schema_version": {
          "type": "keyword"
        },
        "feature_names": {
          "type": "keyword"
        },
        "weights": {
          "type": "object",
          "enabled": false
        },
        "biases": {
          "type": "object",
          "enabled": false
        },
        "source": {
          "type": "keyword"
        },
        "trained_at": {
          "type": "date"
        },
        "training_example_count": {
          "type": "integer"
        },
        "experiments_used": {
          "type": "integer"
        },
        "trapsig": {
          "properties": {
            "schema_version": {
              "type": "keyword"
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "trapsig-policy",
    "trapsig_schema_version": "1"
  }
}
