ELASTIC_PASSWORD=change-this-local-password
ELASTICSEARCH_URL=http://elasticsearch:9200
KIBANA_URL=http://localhost:5601
# PI_HOST is the Pi's stable Tailscale address (MagicDNS name preferred over a raw
# 100.x address, since it survives the Pi being re-imaged/re-authed). It is the
# same on home Wi-Fi or a phone hotspot. `python scripts/pi/connect.py` fills it in.
PI_HOST=trapsig-pi.your-tailnet.ts.net
PI_USER=trapsig
PI_SSH_KEY_PATH=./secrets/pi_ssh_key
PI_KNOWN_HOSTS_PATH=./secrets/known_hosts
# LAB_SUBNET stays a REAL private LAN/hotspot subnet: attacks come from inside the
# physical lab network, not over the Tailscale overlay. Only the laptop<->Pi
# management/telemetry path moves onto Tailscale.
LAB_SUBNET=192.168.50.0/24
TRAPSIG_REVISION=
# Optional API auth. Leave blank for the open isolated lab. Set a shared secret to
# require the X-API-Key header on every request (health check and docs exempt);
# the frontend forwards it automatically. Terminate TLS at a reverse proxy.
API_KEY=
# Role-based keys (preferred): comma-separated role:key pairs. Roles: viewer,
# analyst, admin, sensor. Example:
#   API_KEYS=viewer:...,analyst:...,admin:...,sensor:...
API_KEYS=
# Key the Next.js server attaches for browser requests (choose the least role the
# console needs; admin for rule/persona management). Falls back to API_KEY.
FRONTEND_API_KEY=
# hybrid (rules + learned policy + anomaly), rules, or ml.
DETECTION_MODE=hybrid
# Set to false on extra backend replicas so only one instance writes derived data.
PROCESSOR_ENABLED=true
EXPERIMENT_SETTLE_TIMEOUT_SECONDS=25
EXPERIMENT_SETTLE_QUIET_SECONDS=3
EXPERIMENT_SETTLE_POLL_SECONDS=1
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://backend:8000
# Browser/admin ports bind only to this laptop; Beats must be reachable from the Pi.
LOCAL_BIND_HOST=127.0.0.1
BEATS_BIND_HOST=0.0.0.0
# Native sensor agents ship telemetry to Logstash's HTTP input (port 5045) with
# these credentials. CHANGE the password; set the same values in each agent's
# trapsig-sensor.toml (ingest_user / ingest_password).
TRAPSIG_INGEST_USER=trapsig
TRAPSIG_INGEST_PASSWORD=change-this-ingest-password
